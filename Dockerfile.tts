# Background narrator for the books reader (app/books/worker.py).
FROM python:3.12-slim

WORKDIR /app
RUN mkdir /models && python -c "import urllib.request as u; \
[u.urlretrieve(f'https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.0/{f}', f'/models/{f}') \
 for f in ('kokoro-v1.0.onnx', 'voices-v1.0.bin')]"

COPY requirements-tts.txt .
RUN pip install --no-cache-dir -r requirements-tts.txt

COPY app/__init__.py ./app/__init__.py
COPY app/books ./app/books

CMD ["python", "-m", "app.books.worker"]
