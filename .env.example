# Copy to .env and fill in. .env is gitignored — never commit real credentials.
CLOUDFLARE_TUNNEL_TOKEN=

# Gmail (reads Royal Road, fiction.live, and AO3 notification emails over IMAP)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
GMAIL_LABEL=serials

# SpaceBattles
SPACEBATTLES_USERNAME=
SPACEBATTLES_PASSWORD=

# Sufficient Velocity
SUFFICIENTVELOCITY_USERNAME=
SUFFICIENTVELOCITY_PASSWORD=

# Questionable Questing
QUESTIONABLEQUESTING_USERNAME=
QUESTIONABLEQUESTING_PASSWORD=

# fiction.live
FICTIONLIVE_USERNAME=
FICTIONLIVE_PASSWORD=

# Unlisted URL path for the serial updates page (generate something random)
SERIALS_PATH=

# Optional: Royal Road fiction URLs or IDs to track before any notification email arrives
ROYALROAD_FICTIONS=
